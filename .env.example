# Copy to .env and set your own values. Never commit .env.
# The values below are placeholders, not secrets.

# Salt mixed into SHA-256 hashes. Changing it changes every hash.
PII_HASH_SALT=replace-with-a-long-random-string

# HMAC key for deterministic tokenisation. Changing it breaks joins on tokens.
PII_TOKEN_KEY=replace-with-a-different-long-random-string

# Base64-encoded 32-byte master key for LocalKeyManager (demo only).
# Generate one with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PII_LOCAL_MASTER_KEY=

# Recorded as "who" in the audit log; defaults to the OS user.
PII_ACTOR=

# Only for AwsKmsKeyManager (not used in tests or CI).
# AWS_REGION=eu-west-1
# PII_KMS_KEY_ID=alias/your-key-alias
